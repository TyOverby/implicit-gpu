{
  "permissions": {
    "allow": [
      "WebFetch(domain:crates.io)",
      "Bash(cargo search:*)",
      "Bash(cargo build:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo info:*)",
      "Bash(cargo update:*)",
      "Bash(git clone:*)",
      "Bash(cargo doc:*)",
      "WebFetch(domain:docs.rs)",
      "Bash(git rm:*)",
      "Bash(git submodule:*)",
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git remote add:*)",
      "Bash(git push:*)",
      "WebFetch(domain:index.crates.io)",
      "WebFetch(domain:static.crates.io)",
      "Bash(cargo test:*)",
      "Bash(find:*)",
      "Bash(git lfs pull:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  }
}
