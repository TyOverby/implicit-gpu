{
  "permissions": {
    "allow": [
      "WebFetch(domain:crates.io)",
      "Bash(cargo search:*)",
      "Bash(cargo build:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo info:*)",
      "Bash(cargo update:*)",
      "Bash(git clone:*)",
      "Bash(cargo doc:*)",
      "WebFetch(domain:docs.rs)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  }
}
